# Copy to .env and fill in real values. Never commit .env itself.
# Local development does NOT need this file - Spring reads
# application-local.properties from the project root instead.

# Local MySQL
DB_URL=jdbc:mysql://localhost:3306/payroll_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=payroll_app
DB_PASSWORD=

# Render injects PORT automatically. Set manually only to override.
PORT=8080

# Comma-separated profiles. "demo" enables DemoDataSeeder.
# "render" switches the datasource to MySQL via DB_URL/DB_USERNAME/DB_PASSWORD.
SPRING_PROFILES_ACTIVE=
APP_DEMO_DATA_ENABLED=

# Free-tier hosts give 512MB RAM. Keep the heap small.
JAVA_OPTS=-Xmx192m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC
